--- a/shairport.c
+++ b/shairport.c
@@ -160,7 +160,12 @@ int has_fltp_capable_aac_decoder(void) {
   const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_AAC);
   if (codec != NULL) {
-    const enum AVSampleFormat *p = codec->sample_fmts;
+#if LIBAVCODEC_VERSION_MAJOR >= 61
+    const enum AVSampleFormat *p;
+    int ret = avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0, (const void **)&p, NULL);
+    if (ret < 0 || p == NULL) return 0;
+#else
+    const enum AVSampleFormat *p = codec->sample_fmts;
+#endif
     if (p != NULL) {
       while ((has_capability == 0) && (*p != AV_SAMPLE_FMT_NONE)) {
         if (*p == AV_SAMPLE_FMT_FLTP)
           has_capability = 1;
         p++;
       }
     }
   }
   return has_capability;
 }

